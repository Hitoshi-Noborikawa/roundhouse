#!/usr/bin/env ruby
# scripts/lobsters-http-replay — drive a RUNNING lobsters server over HTTP,
# from outside the process, and dump each response body.
#
# The in-process replays (scripts/lobsters-replay, lobsters-spinel-replay)
# call Main.run_rack / Main.dispatch directly, so they never exercise the
# socket, the HTTP parser, cookies on the wire or the server loop. This one
# talks to whatever listens on --base: the Spinel binary, the CRuby emit
# behind its server, or the real Rails app. Point it at two of them and
# compare the dumps with scripts/lobsters-content-diff (or run
# scripts/lobsters-http-compare, which does both).
#
# A local tool, not a CI lane: it assumes you started the servers, on the
# same data.
#
# Usage:
#   scripts/lobsters-http-replay --base URL --dump DIR [options]
#
#   --base URL        server to drive (e.g. http://127.0.0.1:3931)
#   --dump DIR        write each body to DIR (file = path, non-word -> _)
#                     plus DIR/_status.json (file -> status), the shape
#                     lobsters-content-diff reads, and DIR/_location.json
#                     (file -> Location of each redirect)
#   --steps FILE      the visits, one per line (default: the ruby-bench
#                     route set below). Blank lines and `#` comments are
#                     skipped. A line is
#                       GET /path [-> STATUS]
#                       POST /path key=value&key2=value2 [-> STATUS]
#                     A POST carries the authenticity_token of the last
#                     page fetched (its form field or csrf-token meta),
#                     that page as Referer, and the session cookie. A
#                     path visited again dumps as NAME~2, NAME~3, ….
#                     scripts/lobsters-http-steps/ has examples. {story}, {story_path},
#                     {comment} and {username} expand to ids scraped
#                     after login.
#   --email E         login email    (default $LOBSTERS_EMAIL)
#   --password P      login password (default $LOBSTERS_PASSWORD)
#   --username U      for {username} (default $LOBSTERS_USERNAME, else
#                     scraped from the page after login)
#   --host H          send `Host: H` (default: the --base host:port). Two
#                     servers given the same H render the same absolute
#                     URLs (RSS links, canonical tags), so a compare does
#                     not trip on their ports
#   --no-login        visit logged out
#   --quiet           only the summary
#
# Exit code = number of steps whose status is not the expected one (by
# default 2xx or 3xx; a redirect prints its Location), plus thin 200
# bodies. Redirects are not followed: each step is one request.

require "net/http"
require "uri"
require "json"
require "fileutils"

opts = {
  email: ENV["LOBSTERS_EMAIL"], password: ENV["LOBSTERS_PASSWORD"], username: ENV["LOBSTERS_USERNAME"],
  login: true,
}
args = ARGV.dup
until args.empty?
  case (a = args.shift)
  when "--base"     then opts[:base]     = args.shift
  when "--dump"     then opts[:dump]     = args.shift
  when "--steps"    then opts[:steps]    = args.shift
  when "--email"    then opts[:email]    = args.shift
  when "--password" then opts[:password] = args.shift
  when "--username" then opts[:username] = args.shift
  when "--host"     then opts[:host]     = args.shift
  when "--no-login" then opts[:login]    = false
  when "--quiet"    then opts[:quiet]    = true
  else abort "lobsters-http-replay: unknown arg #{a}"
  end
end
abort "usage: lobsters-http-replay --base URL --dump DIR [options]" unless opts[:base] && opts[:dump]
if opts[:login] && !(opts[:email] && opts[:password])
  abort "lobsters-http-replay: --email and --password (or LOBSTERS_EMAIL / LOBSTERS_PASSWORD), or --no-login"
end

BASE = URI(opts[:base])
HOST = opts[:host]

# The ruby-bench parity route set (scripts/lobsters-replay ROUTES), as
# steps, so dumps from either lane join by file name. Several of those are
# legacy URLs that now redirect, so the pages they redirect to follow.
DEFAULT_STEPS = <<~STEPS
  GET /u
  GET /active
  GET /newest
  GET /recent
  GET /hottest
  GET /rss
  GET /privacy
  GET /about
  GET /settings
  GET /top?length=1d
  GET /top?length=1w
  GET /top?length=1y
  GET /hidden
  GET /saved
  GET /upvoted/stories
  GET /comments
  GET /upvoted/comments
  GET /threads
  GET /comments/{comment}/reply
  GET /threads/{username}
  GET /u/{username}
  GET /replies
  GET /replies/comments
  GET /replies/stories
  GET /replies/unread
  GET /s/{story}
  GET /
  GET /users
  GET /~{username}
  GET /~{username}/threads
  GET /inbox/all
  GET /inbox/unread
  GET {story_path}
  GET /stats
  GET /search?q=hello&what=all&order=newest
STEPS

Step = Struct.new(:method, :path, :form, :expect)

def parse_steps(text)
  text.lines.filter_map do |line|
    line = line.sub(/#.*/, "").strip
    next if line.empty?
    line, expect = line.split(/\s*->\s*/, 2)
    method, path, form = line.split(/\s+/, 3)
    abort "lobsters-http-replay: bad step #{line.inspect}" unless %w[GET POST].include?(method) && path
    Step.new(method, path, form, expect&.to_i)
  end
end

# ── HTTP with a cookie jar ───────────────────────────────────────────
$jar = {}
$last_body = ""
$last_url = nil

def http
  @http ||= Net::HTTP.start(BASE.host, BASE.port, use_ssl: BASE.scheme == "https").tap { |h| h.read_timeout = 60 }
end

def absorb_cookies(response)
  Array(response.get_fields("set-cookie")).each do |line|
    k, v = line.split(";", 2).first.to_s.split("=", 2)
    $jar[k.strip] = v.to_s if k && !k.strip.empty?
  end
end

def request(method, path, form: nil)
  req = method == "POST" ? Net::HTTP::Post.new(path) : Net::HTTP::Get.new(path)
  req["Referer"] = $last_url if method == "POST" && $last_url
  req["Cookie"] = $jar.map { |k, v| "#{k}=#{v}" }.join("; ") unless $jar.empty?
  req["Accept"] = "text/html"
  req["Host"] = HOST if HOST
  if form
    req["Content-Type"] = "application/x-www-form-urlencoded"
    req.body = form
  end
  t = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  res = http.request(req)
  ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - t) * 1000).round(1)
  absorb_cookies(res)
  body = res.body.to_s
  if method == "GET"
    $last_body = body
    $last_url = "#{BASE.scheme}://#{HOST || "#{BASE.host}:#{BASE.port}"}#{path}"
  end
  [res.code.to_i, body, res["location"], ms]
rescue StandardError => e
  [:EXC, "#{e.class}: #{e.message}", nil, 0]
end

def token_of(body)
  body[/name="authenticity_token"[^>]*value="([^"]+)"/, 1] ||
    body[/value="([^"]+)"[^>]*name="authenticity_token"/, 1] ||
    body[/<meta name="csrf-token" content="([^"]+)"/, 1]
end

def enc(s) = URI.encode_www_form_component(s.to_s)

def body_name(path)
  name = path.delete_prefix("/").gsub(/[^\w.-]/, "_")
  name.empty? ? "root" : name
end

# ── login, then the ids the steps name ──────────────────────────────
if opts[:login]
  st, body, = request("GET", "/login")
  abort "lobsters-http-replay: GET /login -> #{st}" unless st == 200
  token = token_of(body) or abort "lobsters-http-replay: no authenticity_token on /login"
  form = "email=#{enc(opts[:email])}&password=#{enc(opts[:password])}&authenticity_token=#{enc(token)}"
  st, _body, location, = request("POST", "/login", form: form)
  abort "lobsters-http-replay: POST /login -> #{st} (expected 302; wrong credentials?)" unless st == 302
  $stderr.puts "logged in as #{opts[:email]} (-> #{location})" unless opts[:quiet]
end

ids = {}
_, newest, = request("GET", "/newest")
ids["story"] = newest[%r{href="/s/(\w+)}, 1]
ids["story_path"] = newest[%r{href="(/s/\w+/[^"/?#]+)"}, 1]
_, comments, = request("GET", "/comments")
ids["comment"] = comments[%r{/comments/(\w+)/reply}, 1] || comments[%r{/c/(\w+)}, 1]
_, settings, = request("GET", "/settings") if opts[:login]
ids["username"] = opts[:username] || settings.to_s[%r{href="/(?:~|u/)(\w+)"}, 1]

steps = parse_steps(opts[:steps] ? File.read(opts[:steps]) : DEFAULT_STEPS)
expand = lambda do |s|
  s.gsub(/\{(\w+)\}/) { ids[$1] || abort("lobsters-http-replay: no #{$1} to put in #{s.inspect} (none scraped)") }
end

# ── the visits ───────────────────────────────────────────────────────
FileUtils.mkdir_p(opts[:dump])
THIN_BYTES = 200
statuses = {}
locations = {}
failures = 0
steps.each do |step|
  path = expand.(step.path)
  form = step.form && expand.(step.form)
  if step.method == "POST"
    token = token_of($last_body)
    form = [form, ("authenticity_token=#{enc(token)}" if token)].compact.join("&")
  end
  st, body, location, ms = request(step.method, path, form: form)
  name = (step.method == "POST" ? "POST_" : "") + body_name(path)
  name = "#{name}~#{(2..).find { |i| !statuses.key?("#{name}~#{i}") }}" if statuses.key?(name)
  statuses[name] = st
  locations[name] = location if location
  File.write(File.join(opts[:dump], name), body) unless st == :EXC
  ok = step.expect ? st == step.expect : st.is_a?(Integer) && (200..399).cover?(st)
  thin = st == 200 && body.bytesize < THIN_BYTES
  failures += 1 if !ok || thin
  next if opts[:quiet] && ok && !thin
  note = thin ? " THIN" : ""
  note += " -> #{location}" if location
  note += " (expected #{step.expect})" if step.expect && !ok
  note += " #{body}" if st == :EXC
  $stderr.puts format("%-4s %-5s %-36s %7d B %8.1f ms%s", ok && !thin ? "ok" : "FAIL", st, "#{step.method} #{path}", body.bytesize, ms, note)
end
File.write(File.join(opts[:dump], "_status.json"), JSON.pretty_generate(statuses))
File.write(File.join(opts[:dump], "_location.json"), JSON.pretty_generate(locations))
$stderr.puts "#{steps.size - failures}/#{steps.size} steps ok; bodies -> #{opts[:dump]}"
exit failures
