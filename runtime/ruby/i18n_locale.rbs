module I18n
  class InvalidLocale < ArgumentError
  end

  def self.default_locale: () -> Symbol
  def self.available_locales: () -> Array[Symbol]
  def self.thread_locale_name: () -> String
  def self.locale: () -> Symbol
  def self.locale=: (String | Symbol | nil value) -> String
  def self.checked_locale: (String | Symbol | nil value) -> Symbol
  def self.locale_name: (String | Symbol | nil value) -> String
  def self.enter_locale: (String | Symbol | nil value) -> String?
  def self.leave_locale: (String? previous) -> nil
  def self.running_in?: (String envs) -> bool
  def self.app_default_locale: () -> Symbol
  def self.app_available_locales: () -> Array[Symbol]

  class MissingTranslationData < ArgumentError
  end

  def self.normalize_key: (String key) -> String
  def self.subtree_translation: (String key) -> String
  def self.missing_raises: (bool raises, String flipped) -> bool
  def self.missing_translation: (String key, bool raises) -> String
  def self.missing_translation_among: (String key, String rest, bool raises) -> String
  def self.missing_translation_tag: (String key, String details, bool raises) -> String
  def self.translate_site: (String id, String loc, String key, Integer? count, Array[String] names, Array[String] values, String details, bool raises, bool in_view, bool escape_plain) -> String
  def self.site_entry: (String id, String loc, String key) -> Array[String]
  def self.site_entry_in: (String id, String loc, String key) -> Integer?
  def self.render_template: (String template, Integer? count, Array[String] names, Array[String] values, bool html) -> String
  def self.translation_table: () -> Hash[String, Integer]
  def self.translation_entries: () -> Array[Array[String]]
  def self.load_translation_table: () -> nil
end
