# Typing contract for the ActionMailer delivery-capture runtime.
# Header values are untyped by design — they arrive through mail()'s
# heterogeneous opts hash and nothing downstream re-dispatches on them.
module ActionMailer
  class Part
    @body: String
    @mime: String

    def initialize: (String body, String mime) -> void
    def body: () -> String
    def decoded: () -> String
    def mime_type: () -> String
  end

  class Header
    @name: String
    @value: String

    def initialize: (String name, String value) -> void
    def name: () -> String
    def value: () -> String
  end

  class Message
    @headers: Hash[String, String]
    @to: Array[String]?
    @from: Array[String]?
    @cc: Array[String]?
    @bcc: Array[String]?
    @reply_to: Array[String]?
    @subject: untyped
    @text_body: String?
    @html_body: String?
    @body: String

    def initialize: (Hash[Symbol, untyped] opts, ?String? text_body, ?String? html_body) -> void
    def self.addresses: (untyped value) -> Array[String]?
    def to: () -> Array[String]?
    def from: () -> Array[String]?
    def cc: () -> Array[String]?
    def bcc: () -> Array[String]?
    def reply_to: () -> Array[String]?
    def subject: () -> untyped
    def headers: () -> Hash[String, String]
    def add_header: (String name, String value) -> String
    def []: (String name) -> Header?
    def self.joined: (Array[String]? list) -> String?
    def body: () -> String
    def multipart?: () -> bool
    def text_part: () -> Part?
    def html_part: () -> Part?
    def deliver_now: () -> Message
    def deliver_later: () -> Message
  end

  class Base
    self.@deliveries: Array[Message]
    @params: Hash[Symbol, untyped]?
    @_message: Message?
    @_action_name: String?
    @_headers: Hash[String, String]?

    def self.default: (?Hash[Symbol, untyped]? opts) -> nil
    def self.deliveries: () -> Array[Message]
    def mail: (Hash[Symbol, untyped] opts, ?String? text_body, ?String? html_body) -> Message
    def params: () -> Hash[Symbol, untyped]
    def _with_params: (Hash[Symbol, untyped] params) -> self
    def message: () -> Message?
    def action_name: () -> String
    def __start_action: (String name) -> String
    def headers: (?Hash[String, String]? values) -> Headers
    def __headers: () -> Hash[String, String]
    def __add_header: (String name, String value) -> String
  end

  class Headers
    @mailer: Base

    def initialize: (Base mailer) -> void
    def []=: (String name, String value) -> String
    def []: (String name) -> String?
  end
end
